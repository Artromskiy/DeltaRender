<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.Tests</RootNamespace>
    <AssemblyName>DeltaRender.Tests</AssemblyName>
    <PackageId>DeltaRender.Tests</PackageId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests intentionally build source-only shader fixtures, generated shader projects and the non-packable XAML adapter. -->
    <ProjectReference Include="../../tools/DeltaRender.FullscreenShaders/DeltaRender.FullscreenShaders.csproj" />
    <ProjectReference Include="../../tools/DeltaRender.UIShaders/DeltaRender.UIShaders.csproj" />
    <ProjectReference Include="../../src/DeltaRender.Text/DeltaRender.Text.csproj" />
    <ProjectReference Include="../../src/DeltaRender.UI/DeltaRender.UI.csproj" />
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader/DeltaShader.csproj" />
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader.Compiler/DeltaShader.Compiler.csproj" />
    <PackageReference Include="DeltaRender" />
    <PackageReference Include="DeltaRender.Platform.SDL3" />
    <PackageReference Include="DeltaRender.Vulkan" />
    <PackageReference Include="Delta.Diagnostics.Contract" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\..\\src\\DeltaRender.XAML\\DeltaRender.XAML.csproj" />
    <ProjectReference Include="../../src/DeltaRender.Graphics.Semantics/DeltaRender.Graphics.Semantics.csproj" />
    <PackageReference Include="DeltaXAML.Contract" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\delta-text-atlas\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../DeltaText/tests/DeltaText.Tests/Fixtures/NotoSans-Regular.ttf" Link="Fixtures/NotoSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyDeltaRenderTextShaderArtifacts" AfterTargets="Build">
    <ItemGroup>
      <_DeltaRenderTextShaderArtifact Include="../../src/DeltaRender.Text/$(OutputPath)DeltaShader/DeltaRender.Text/**/*.spv;../../src/DeltaRender.Text/$(OutputPath)DeltaShader/DeltaRender.Text/**/*.glsl;../../src/DeltaRender.Text/$(OutputPath)DeltaShader/DeltaRender.Text/**/*.shader.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeltaRenderTextShaderArtifact)" DestinationFolder="$(TargetDir)DeltaShader/DeltaRender.Text" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDeltaRenderUiShaderArtifacts" AfterTargets="Build">
    <ItemGroup>
      <_DeltaRenderUiShaderArtifact Include="../../tools/DeltaRender.UIShaders/$(OutputPath)DeltaShader/DeltaRender.UIShaders/**/*.spv;../../tools/DeltaRender.UIShaders/$(OutputPath)DeltaShader/DeltaRender.UIShaders/**/*.glsl;../../tools/DeltaRender.UIShaders/$(OutputPath)DeltaShader/DeltaRender.UIShaders/**/*.shader.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeltaRenderUiShaderArtifact)" DestinationFolder="$(TargetDir)DeltaShader/DeltaRender.UIShaders" SkipUnchangedFiles="true" />
  </Target>
</Project>
