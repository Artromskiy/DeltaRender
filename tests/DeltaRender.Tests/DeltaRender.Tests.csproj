<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.Tests</RootNamespace>
    <AssemblyName>DeltaRender.Tests</AssemblyName>
    <PackageId>DeltaRender.Tests</PackageId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests intentionally build source-only shader fixtures, generated shader projects and the non-packable XAML adapter. -->
    <ProjectReference Include="../../tools/DeltaRender.FullscreenShaders/DeltaRender.FullscreenShaders.csproj" />
    <ProjectReference Include="../../tools/DeltaRender.UIShaders/DeltaRender.UIShaders.csproj" />
    <ProjectReference Include="../../src/DeltaRender.Text/DeltaRender.Text.csproj" />
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader/DeltaShader.csproj" />
    <PackageReference Include="DeltaRender" />
    <PackageReference Include="DeltaRender.Platform.SDL3" />
    <PackageReference Include="DeltaRender.Vulkan" />
    <PackageReference Include="Delta.Diagnostics.Contract" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\..\\src\\DeltaRender.XAML\\DeltaRender.XAML.csproj" />
    <ProjectReference Include="../../src/Delta.Graphics.Semantics/Delta.Graphics.Semantics.csproj" />
    <PackageReference Include="DeltaXAML.Contract" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\delta-text-atlas\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../DeltaText/tests/DeltaText.Tests/Fixtures/NotoSans-Regular.ttf" Link="fixtures/NotoSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
