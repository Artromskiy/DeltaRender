<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.FullscreenShaders</RootNamespace>
    <AssemblyName>DeltaRender.FullscreenShaders</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DeltaShaderEnabled>true</DeltaShaderEnabled>
  </PropertyGroup>

  <ItemGroup>
    <DeltaShaderSource Include="Shaders/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Uv0 is a DeltaShader semantic wrapper, not a renderer-local type. -->
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader.SemanticTypes/DeltaShader.SemanticTypes.csproj" />
    <PackageReference Include="DeltaShader.Contract" />
    <PackageReference Include="DeltaShader.Compiler" PrivateAssets="all" />
    <PackageReference Include="DeltaShader.Analyzers" PrivateAssets="all" OutputItemType="Analyzer" />
    <PackageReference Include="DeltaMaths" />
    <PackageReference Include="DeltaShader.Tool" PrivateAssets="all" />
  </ItemGroup>
</Project>
