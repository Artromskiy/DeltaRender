<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.FullscreenShaders</RootNamespace>
    <AssemblyName>Delta.Render.FullscreenShaders</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../DeltaShader/src/Delta.Shader.Abstractions/Delta.Shader.Abstractions.csproj" />
    <ProjectReference Include="../../../DeltaShader/src/Delta.Shader.Contract/Delta.Shader.Contract.csproj" />
    <ProjectReference Include="../../../DeltaShader/src/Delta.Shader.Analyzers/Delta.Shader.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Analyzer Include="../../../DeltaShader/src/Delta.Shader.Abstractions/bin/$(Configuration)/netstandard2.0/Delta.Shader.Abstractions.dll" />
    <Analyzer Include="../../../DeltaShader/src/Delta.Shader.Compiler/bin/$(Configuration)/netstandard2.0/Delta.Shader.Compiler.dll" />
    <Analyzer Include="../../../DeltaShader/src/Delta.Shader.Backend.Glsl/bin/$(Configuration)/netstandard2.0/Delta.Shader.Backend.Glsl.dll" />
    <ProjectReference Include="../../../Maths/Delta.Maths.csproj">
      <SetTargetFramework>TargetFramework=netstandard2.1</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>
</Project>
