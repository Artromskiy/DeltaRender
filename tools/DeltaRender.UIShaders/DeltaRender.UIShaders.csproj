<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.UIShaders</RootNamespace>
    <AssemblyName>DeltaRender.UIShaders</AssemblyName>
    <PackageId>DeltaRender.UIShaders</PackageId>
    <Version>0.0.1</Version>
    <IsPackable>true</IsPackable>
    <DeltaShaderEnabled>true</DeltaShaderEnabled>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/Generated/UiShaders</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <DeltaShaderSource Include="Shaders/**/*.cs" />
    <None Update="UiShaderVariants.json" Pack="true" PackagePath="build/DeltaRender.UIShaders/UiShaderVariants.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeltaShader.Contract" />
    <PackageReference Include="DeltaShader.Compiler" PrivateAssets="all" />
    <PackageReference Include="DeltaShader.Analyzers" PrivateAssets="all" OutputItemType="Analyzer" />
    <PackageReference Include="DeltaMaths" />
    <PackageReference Include="DeltaShader.Tool" PrivateAssets="all" />
    <ProjectReference Include="../../src/DeltaRender.Graphics.Semantics/DeltaRender.Graphics.Semantics.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectUiShaderArtifacts</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CollectUiShaderArtifacts" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <_UiShaderArtifact Include="$(OutputPath)DeltaShader/$(AssemblyName)/**/*.spv;$(OutputPath)DeltaShader/$(AssemblyName)/**/*.glsl;$(OutputPath)DeltaShader/$(AssemblyName)/**/*.shader.json;$(OutputPath)DeltaShader/$(AssemblyName)/**/*.abi.json" />
      <TfmSpecificPackageFile Include="@(_UiShaderArtifact)">
        <PackagePath>contentFiles/any/any/DeltaShader/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
