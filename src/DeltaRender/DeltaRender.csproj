<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render</RootNamespace>
    <AssemblyName>DeltaRender</AssemblyName>
    <PackageId>DeltaRender</PackageId>
    <Version>0.0.14</Version>
    <IsPackable>true</IsPackable>
    <Authors>Artromskiy</Authors>
    <Description>Renderer-neutral Vulkan RenderGraph contracts for DeltaRender.</Description>
    <PackageTags>rendering;vulkan;render-graph;contracts</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaRender</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Delta.Diagnostics.Contract" />
    <PackageReference Include="DeltaShader.Contract" />
  </ItemGroup>
</Project>
