<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.Text</RootNamespace>
    <AssemblyName>DeltaRender.Text</AssemblyName>
    <PackageId>DeltaRender.Text</PackageId>
    <Version>0.0.1</Version>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <DeltaShaderEnabled>true</DeltaShaderEnabled>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/Generated/TextShaders</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <DeltaShaderSource Include="Shaders/**/*.cs" />
    <None Update="TextShaderVariants.json" Pack="true" PackagePath="build/DeltaRender.Text/TextShaderVariants.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeltaRender" />
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader.Contract/DeltaShader.Contract.csproj" />
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader/DeltaShader.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader.Analyzers/DeltaShader.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../DeltaRender.Graphics.Semantics/DeltaRender.Graphics.Semantics.csproj" />
    <Analyzer Include="../../../DeltaShader/src/DeltaShader.Analyzers/bin/$(Configuration)/netstandard2.0/DeltaShader.Analyzers.dll" />
    <Analyzer Include="../../../DeltaShader/src/DeltaShader/bin/$(Configuration)/netstandard2.0/DeltaShader.dll" />
    <Analyzer Include="../../../DeltaShader/src/DeltaShader.Compiler/bin/$(Configuration)/netstandard2.0/DeltaShader.Compiler.dll" />
    <Analyzer Include="../../../DeltaShader/src/DeltaShader.Backend.Glsl/bin/$(Configuration)/netstandard2.0/DeltaShader.Backend.Glsl.dll" />
    <PackageReference Include="DeltaShader.Tool" PrivateAssets="all" />
    <PackageReference Include="DeltaText" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectTextShaderArtifacts</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CollectTextShaderArtifacts" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <_TextShaderArtifact Include="$(OutputPath)DeltaShader/$(AssemblyName)/**/*.spv;$(OutputPath)DeltaShader/$(AssemblyName)/**/*.glsl;$(OutputPath)DeltaShader/$(AssemblyName)/**/*.shader.json;$(OutputPath)DeltaShader/$(AssemblyName)/**/*.abi.json" />
      <TfmSpecificPackageFile Include="@(_TextShaderArtifact)">
        <PackagePath>contentFiles/any/any/DeltaShader/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
