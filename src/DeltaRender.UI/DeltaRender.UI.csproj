<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.UI</RootNamespace>
    <AssemblyName>DeltaRender.UI</AssemblyName>
    <PackageId>DeltaRender.UI</PackageId>
    <Version>0.0.16</Version>
    <IsPackable>true</IsPackable>
    <Authors>Artromskiy</Authors>
    <Description>Reusable UI rendering provider with DeltaRender and generated UI/text shader programs.</Description>
    <PackageTags>rendering;vulkan;xaml;ui;text;shaders</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaRender</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>DeltaRender.UI.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../docs/DeltaRender.UI.md" Pack="true" PackagePath="DeltaRender.UI.md" Visible="false" />
    <None Include="buildTransitive/DeltaRender.UI.props" Pack="true" PackagePath="buildTransitive/DeltaRender.UI.props" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeltaRender.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Delta.Diagnostics.Contract" />
    <PackageReference Include="DeltaMaths" />
    <PackageReference Include="DeltaShader.Contract" />
    <PackageReference Include="DeltaText" />
    <PackageReference Include="DeltaXAML" />
    <PackageReference Include="DeltaXAML.Generator" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="DeltaRender" />
    <PackageReference Include="DeltaRender.Platform.SDL3" />
    <PackageReference Include="DeltaRender.Vulkan" />
  </ItemGroup>

  <ItemGroup>
    <!-- These source-only adapters are bundled here so consumers do not reference samples or checkout-relative projects. -->
    <ProjectReference Include="../DeltaRender.XAML/DeltaRender.XAML.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../tools/DeltaRender.UIShaders/DeltaRender.UIShaders.csproj" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectDeltaXamlGeneratorFiles;CollectUiBundleFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CollectDeltaXamlGeneratorFiles" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <_DeltaXamlGeneratorFile Include="$(PkgDeltaXAML_Generator)/analyzers/dotnet/cs/**/*.dll" />
      <TfmSpecificPackageFile Include="@(_DeltaXamlGeneratorFile)">
        <PackagePath>analyzers/dotnet/cs/%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="CollectUiBundleFiles" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <_UiBundleAssembly Include="$(TargetDir)DeltaRender.Graphics.Semantics.dll;$(TargetDir)DeltaShader.dll;$(TargetDir)DeltaRender.Text.dll;$(TargetDir)DeltaRender.XAML.dll;$(TargetDir)DeltaRender.UIShaders.dll" />
      <TfmSpecificPackageFile Include="@(_UiBundleAssembly)">
        <PackagePath>lib/$(TargetFramework)/%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>

      <_UiBundleShaderArtifact Include="$(MSBuildProjectDirectory)/../DeltaRender.Text/$(OutputPath)DeltaShader/DeltaRender.Text/**/*.spv;$(MSBuildProjectDirectory)/../DeltaRender.Text/$(OutputPath)DeltaShader/DeltaRender.Text/**/*.glsl;$(MSBuildProjectDirectory)/../DeltaRender.Text/$(OutputPath)DeltaShader/DeltaRender.Text/**/*.shader.json;$(MSBuildProjectDirectory)/../../tools/DeltaRender.UIShaders/$(OutputPath)DeltaShader/DeltaRender.UIShaders/**/*.spv;$(MSBuildProjectDirectory)/../../tools/DeltaRender.UIShaders/$(OutputPath)DeltaShader/DeltaRender.UIShaders/**/*.glsl;$(MSBuildProjectDirectory)/../../tools/DeltaRender.UIShaders/$(OutputPath)DeltaShader/DeltaRender.UIShaders/**/*.shader.json" />
      <TfmSpecificPackageFile Include="@(_UiBundleShaderArtifact)">
        <PackagePath>contentFiles/any/any/DeltaShader/%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
