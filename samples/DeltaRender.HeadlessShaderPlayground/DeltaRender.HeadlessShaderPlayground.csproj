<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.HeadlessShaderPlayground</RootNamespace>
    <AssemblyName>DeltaRender.HeadlessShaderPlayground</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/DeltaRender.SquareShaders/DeltaRender.SquareShaders.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="../../src/DeltaRender/DeltaRender.csproj" />
    <ProjectReference Include="../../src/DeltaRender.Vulkan/DeltaRender.Vulkan.csproj" />
    <PackageReference Include="Delta.Diagnostics.Contract" />
    <PackageReference Include="DeltaShader.Contract" />
  </ItemGroup>
</Project>
