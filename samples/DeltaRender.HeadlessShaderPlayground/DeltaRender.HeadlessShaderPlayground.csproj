<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.HeadlessShaderPlayground</RootNamespace>
    <AssemblyName>DeltaRender.HeadlessShaderPlayground</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The local shader fixture tool is source-only and supplies generated sample artifacts. -->
    <ProjectReference Include="../../tools/DeltaRender.SquareShaders/DeltaRender.SquareShaders.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <PackageReference Include="DeltaRender" />
    <PackageReference Include="DeltaRender.Vulkan" />
    <PackageReference Include="Delta.Diagnostics.Contract" />
    <PackageReference Include="DeltaShader.Contract" />
  </ItemGroup>
</Project>
