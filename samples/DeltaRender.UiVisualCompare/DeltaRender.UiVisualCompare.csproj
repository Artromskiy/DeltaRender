<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.UiVisualCompare</RootNamespace>
    <AssemblyName>DeltaRender.UiVisualCompare</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeltaRender" />
    <PackageReference Include="DeltaRender.Vulkan" />
    <!-- The XAML adapter and generated UI shader project are not yet publishable packages. -->
    <ProjectReference Include="../../src/DeltaRender.XAML/DeltaRender.XAML.csproj" />
    <PackageReference Include="Delta.Diagnostics.Contract" />
    <ProjectReference Include="../../tools/DeltaRender.UIShaders/DeltaRender.UIShaders.csproj" />
    <PackageReference Include="DeltaXAML.Contract" />
  </ItemGroup>
</Project>
