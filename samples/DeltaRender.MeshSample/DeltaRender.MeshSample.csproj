<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Render.MeshSample</RootNamespace>
    <AssemblyName>DeltaRender.MeshSample</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeltaRender" />
    <PackageReference Include="DeltaRender.Vulkan" />
    <PackageReference Include="DeltaShader.Contract" />
    <!-- The generated mesh shader project remains a source-only producer dependency. -->
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader.Mesh/DeltaShader.Mesh.csproj" />
  </ItemGroup>
</Project>
