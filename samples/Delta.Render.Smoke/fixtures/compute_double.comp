#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Values
{
    uint values[];
};

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= values.length())
    {
        return;
    }

    values[index] = values[index] * 2u + 1u;
}
